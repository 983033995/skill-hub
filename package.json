{
  "name": "skill-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "跨 Agent 的 Skill 统一真源管理 + 智能路由 + 省上下文",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "opencode": "node scripts/opencode-hub.mjs",
    "hub": "node apps/cli/dist/index.js",
    "web": "node apps/web/dist/index.js",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "clean": "pnpm -r exec rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "smoke": "node scripts/accept-sandbox.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/983033995/skill-hub.git"
  },
  "bugs": {
    "url": "https://github.com/983033995/skill-hub/issues"
  },
  "homepage": "https://github.com/983033995/skill-hub#readme"
}
