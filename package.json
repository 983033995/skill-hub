{
  "name": "@zhangheteng/skill-hub",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "跨 Agent 的 Skill 统一真源管理 + 智能路由 + 省上下文",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "opencode": "node scripts/opencode-hub.mjs",
    "hub": "node apps/cli/dist/index.js",
    "web": "node apps/web/dist/index.js",
    "pack:npm": "node scripts/pack-npm.mjs",
    "check:npm": "node scripts/accept-npm.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "clean": "pnpm -r exec rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "smoke": "node scripts/accept-sandbox.mjs",
    "benchmark:mcp": "node scripts/benchmark-mcp.mjs",
    "benchmark:opencode": "node scripts/benchmark-opencode-runtime.mjs",
    "eval:router": "node scripts/eval-router.mjs",
    "eval:check": "node scripts/check-router-eval.mjs",
    "eval:router:jev": "node scripts/eval-router-jev.mjs",
    "benchmark:native": "node scripts/benchmark-opencode-native.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/983033995/skill-hub.git"
  },
  "bugs": {
    "url": "https://github.com/983033995/skill-hub/issues"
  },
  "homepage": "https://github.com/983033995/skill-hub#readme"
}
